rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regra existente informada pelo responsável. Precisa de revisão separada.
    match /produtos/{docId} {
      allow read, write: if true;
    }
    match /profilePhotos/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['photoData', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['photoData', 'updatedAt'])
        && request.resource.data.photoData is string
        && request.resource.data.photoData.size() <= 200000
        && request.resource.data.photoData.matches('data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}')
        && request.resource.data.updatedAt == request.time;
    }
    match /userProfiles/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['phone', 'region', 'participation', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['phone', 'region', 'participation', 'updatedAt'])
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30
        && (request.resource.data.phone == '' || request.resource.data.phone.matches('[0-9+(). -]{7,30}'))
        && request.resource.data.region is string
        && request.resource.data.region.size() <= 100
        && request.resource.data.participation is string
        && request.resource.data.participation.size() <= 80
        && request.resource.data.updatedAt == request.time;
    }
  }
}
